# Uploaded files are data, never code. Defence in depth for Apache deployments:
# the application only ever writes re-encoded .jpg/.png/.webp files here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(?i:php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|shtml|html?|svg|js)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes
RemoveHandler .php .phtml .phar .cgi .pl .py
RemoveType .php .phtml .phar

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
