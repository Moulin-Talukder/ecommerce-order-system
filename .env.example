APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Days of files kept when LOG_STACK=daily (production: daily + warning).
LOG_DAILY_DAYS=14

# MySQL 8.0.16+ is required (CHECK constraints, utf8mb4). Tests always use the
# separate database ecommerce_order_system_test (fixed in phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_order_system
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): uncomment and set to true. Leave it unset locally; an empty
# value would disable Secure cookies even over HTTPS.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Initial Super Admin (used once by SuperAdminSeeder; remove ADMIN_PASSWORD after seeding)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Steadfast courier (secrets: keep only in .env)
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=
# Courier HTTP behaviour (defaults shown).
STEADFAST_CONNECT_TIMEOUT=5
STEADFAST_TIMEOUT=20
STEADFAST_LOOKUP_RETRIES=2
STEADFAST_LOOKUP_RETRY_DELAY_MS=300
STEADFAST_STALE_BOOKING_SECONDS=120

# Product images: maximum upload size per file in KB (PHP upload_max_filesize must allow it).
MEDIA_IMAGE_MAX_KB=2048

# Google Tag Manager web container for the storefront (e.g. GTM-ABC1234).
# Empty = disabled. Set the production container ONLY in production; use a
# separate test container (or leave empty) in local/staging. Tests force it empty.
GTM_CONTAINER_ID=

# Storefront tracking consent (encrypted "storefront_consent" cookie). Raise the
# version to ask every shopper again, e.g. after the privacy notice changes.
STOREFRONT_CONSENT_VERSION=1
STOREFRONT_CONSENT_LIFETIME_DAYS=180

# Privacy notice details (shown as placeholders until set; wording needs legal review).
PRIVACY_BUSINESS_NAME=
PRIVACY_BUSINESS_ADDRESS=
PRIVACY_CONTACT=

# Security (config/security.php). Production behind HTTPS also needs:
#   APP_ENV=production, APP_DEBUG=false, SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES: empty = trust no proxy. Behind a load balancer/reverse proxy
# that terminates HTTPS, set its IPs/CIDRs (comma-separated) or "*" if the app
# is reachable only through it.
TRUSTED_PROXIES=
# HSTS seconds (0 = off). Enable only once HTTPS works for the whole domain.
SECURITY_HSTS_MAX_AGE=0
